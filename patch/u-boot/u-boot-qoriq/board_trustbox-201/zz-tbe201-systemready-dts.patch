From eefb768a81af6fa6438821a5db1c72064fd30f33 Mon Sep 17 00:00:00 2001
From: ramazan-yestekbayev <ramazan.yestekbayev@sintecs.eu>
Date: Tue, 31 Mar 2026 16:43:18 +0300
Subject: [PATCH] arm: dts: tbe201: update device tree for SystemReady

---
 arch/arm/dts/tbe201.dts | 426 +++++++++++++++++++++-------------------
 1 file changed, 221 insertions(+), 205 deletions(-)

diff --git a/arch/arm/dts/tbe201.dts b/arch/arm/dts/tbe201.dts
index 163a7e0e762..d4228683677 100644
--- a/arch/arm/dts/tbe201.dts
+++ b/arch/arm/dts/tbe201.dts
@@ -16,12 +16,23 @@
 
 / {
 	model = "Scalys TrustSOM on Trustbox Edge 201 Carrier";
-	compatible = "fsl,ls1028a";
+	compatible = "scalys,trustbox-edge-201", "fsl,ls1028a-rdb", "fsl,ls1028a";
 
 	aliases {
 		crypto = &crypto;
+		ethernet0 = &enetc_port0;
+		ethernet1 = &enetc_port2;
+		ethernet2 = &mscc_felix_port0;
+		ethernet3 = &mscc_felix_port1;
+		ethernet4 = &mscc_felix_port2;
+		ethernet5 = &mscc_felix_port3;
+		ethernet6 = &mscc_felix_port4;
+		ethernet7 = &mscc_felix_port5;
+		ethernet8 = &enetc_port3;
+		mmc0 = &esdhc;
+		mmc1 = &esdhc1;
+		rtc1 = &ftm_alarm1;
 		serial0 = &duart0;
-		serial1 = &duart1;
 	};
 
 	chosen {
@@ -30,309 +41,302 @@
 
 	memory@80000000 {
 		device_type = "memory";
-		reg = <0x0 0x80000000 0x1 0x0000000>;
+		reg = <0x00000000 0x80000000 0x00000000 0x80000000>,
+		      <0x00000020 0x80000000 0x00000000 0x80000000>;
 	};
 
-	/* Fix incorrectly named node such that bootloader can find it */
-	/delete-node/ clock-sysclk;
-	sysclk: sysclk {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <100000000>;
-		clock-output-names = "sysclk";
+	psci {
+		compatible = "arm,psci-1.0", "arm,psci-0.2";
+		method = "smc";
 	};
 
 	leds {
 		compatible = "gpio-leds";
 
-		led0: redled  {
-			label = "redled";
+		led-0 {
 			color = <LED_COLOR_ID_RED>;
-			gpio = <&gpio3 5 GPIO_ACTIVE_HIGH>; /* GPIO3_5 */
+			function = LED_FUNCTION_FAULT;
+			gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
 			default-state = "off";
 		};
 
-		led1: greenled  {
-			label = "greenled";
+		led-1 {
 			color = <LED_COLOR_ID_GREEN>;
-			gpio = <&gpio3 3 GPIO_ACTIVE_HIGH>; /* GPIO3_3 */
+			function = LED_FUNCTION_POWER;
+			gpios = <&gpio3 3 GPIO_ACTIVE_HIGH>;
 			default-state = "on";
 		};
 
-		 led2: blueled  {
-			label = "blueled";
+		led-2 {
 			color = <LED_COLOR_ID_BLUE>;
-			gpio = <&gpio3 2 GPIO_ACTIVE_HIGH>; /* GPIO3_2 */
+			function = LED_FUNCTION_INDICATOR;
+			gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>;
 			default-state = "off";
 		};
 	};
 
+	reg_1p8v: regulator-1p8v {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-max-microvolt = <1800000>;
+		regulator-min-microvolt = <1800000>;
+		regulator-name = "1P8V";
+	};
+
+	sb_3v3: regulator-sb3v3 {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-max-microvolt = <3300000>;
+		regulator-min-microvolt = <3300000>;
+		regulator-name = "3v3_vbus";
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		optee_tzdram: optee@fc000000 {
+			no-map;
+			reg = <0x00000000 0xfc000000 0x00000000 0x03e00000>;
+		};
+
+		optee_shm: shm@ffe00000 {
+			reg = <0x00000000 0xffe00000 0x00000000 0x00200000>;
+		};
+	};
+
 	sfp0: sfp {
 		compatible = "sff,sfp";
 		i2c-bus = <&i2c2>;
-		mod-def0-gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
 		los-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
-		tx-fault-gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
-		tx-disable-gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
 		maximum-power-milliwatt = <2000>;
+		mod-def0-gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
+		tx-disable-gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
+		tx-fault-gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
 	};
 };
 
+&dspi2 {
+	spi-num-chipselects = <1>;
+
+	status = "okay";
+
+	tpm@0 {
+		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+	};
+};
+
+&duart0 {
+	status = "okay";
+};
+
+&enetc_mdio_pf3 {
+	qsgmii_phy0: ethernet-phy@4 {
+		reg = <0x4>;
+	};
+
+	qsgmii_phy1: ethernet-phy@5 {
+		reg = <0x5>;
+	};
+
+	qsgmii_phy2: ethernet-phy@6 {
+		reg = <0x6>;
+	};
+
+	qsgmii_phy3: ethernet-phy@7 {
+		reg = <0x7>;
+	};
+};
+
+&enetc_port0 {
+	managed = "in-band-status";
+	phy-connection-type = "sgmii";
+	sfp = <&sfp0>;
+
+	status = "okay";
+};
+
+&enetc_port2 {
+	status = "okay";
+};
+
+&enetc_port3 {
+	status = "okay";
+};
+
+&esdhc {
+	cd-gpios = <&gpio1 31 GPIO_ACTIVE_LOW>;
+	disable-wp;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+
+	status = "okay";
+};
+
+&esdhc1 {
+	bus-width = <8>;
+	mmc-hs200-1_8v;
+	non-removable;
+	voltage-ranges = <1800 1800>;
+
+	status = "okay";
+};
+
+&ftm_alarm1 {
+	status = "okay";
+};
+
 &gpio1 {
 	gpio-line-names = "", "", "", "", "", "", "UART_2_SIN", "UART_2_SOUT",
-		"", "", "UART_1_SIN", "UART_1_SOUT", "", "", "", "", "", "", "", "",
-		"", "", "USB_2_DRVVBUS", "USB_2_PWRFAULT", "", "", "", "", "", "",
-		"SDHC_1_WP", "SDHC_1_CD";
+			  "", "", "UART_1_SIN", "UART_1_SOUT", "", "", "", "", "", "",
+			  "", "", "", "", "USB_2_DRVVBUS", "USB_2_PWRFAULT", "", "",
+			  "", "", "", "", "SDHC_1_WP", "SDHC_1_CD";
 
-	SDHC_1_WP {
+	default-output-low-hog {
 		gpio-hog;
-		gpios = <30 0>;
+		gpios = <6 0>, <7 0>, <22 0>, <23 0>, <26 0>, <27 0>;
+		line-name = "gpio1_default_output_low";
 		output-low;
-		line-name = "SDHC_1_WP";
 	};
 
-	gpio1_default_output_low {
+	sdhc-1-wp-hog {
 		gpio-hog;
-		gpios = <6 0>, <7 0>, <22 0>, <23 0>, <26 0>, <27 0>;
+		gpios = <30 0>;
+		line-name = "SDHC_1_WP";
 		output-low;
-		line-name = "gpio1_default_output_low";
 	};
 };
 
 &gpio2 {
 	gpio-line-names = "", "", "", "", "", "", "ASLEEP", "CLKOUT", "", "", "",
-		"", "", "", "", "", "", "", "", "", "M2_E_W_DISABLE_1_N", "EXPANSION PIN4",
-		"EXPANSION PIN6", "M2_B_W_DISABLE_1_N", "M2_B_POWER_OFF_N", "EXPANSION PIN8",
-		"M2_B_CONFIG_0", "ALERT_5V_SOM_N", "M2_B_CONFIG_2", "ALERT_12V_N",
-		"M2_B_CONFIG_3", "M2_B_CONFIG_1";
+			  "", "", "", "", "", "", "", "", "", "M2_E_W_DISABLE_1_N",
+			  "EXPANSION PIN4", "EXPANSION PIN6", "M2_B_W_DISABLE_1_N",
+			  "M2_B_POWER_OFF_N", "EXPANSION PIN8", "M2_B_CONFIG_0",
+			  "ALERT_5V_SOM_N", "M2_B_CONFIG_2", "ALERT_12V_N",
+			  "M2_B_CONFIG_3", "M2_B_CONFIG_1";
 
-	gpio2_default_output_low {
+	default-output-high-hog {
 		gpio-hog;
-		gpios = <7 0>;
-		output-low;
-		line-name = "gpio2_default_output_low";
+		gpios = <20 0>, <23 0>, <24 0>;
+		line-name = "gpio2_default_output_high";
+		output-high;
 	};
 
-	gpio2_default_output_high {
+	default-output-low-hog {
 		gpio-hog;
-		gpios = <20 0>, <23 0>, <24 0>;
-		output-high;
-		line-name = "gpio2_default_output_high";
+		gpios = <7 0>;
+		line-name = "gpio2_default_output_low";
+		output-low;
 	};
 };
 
 &gpio3 {
 	gpio-line-names = "SFP_TX_DISABLE", "SFP_MOD_ABS", "MDINT_N", "DP_PWR_EN",
-		"EXPANSION PIN2", "DP_PWR_FAULT_N", "SFP_TX_FAULT", "SFP_LOS", "RESET_TPM_N",
-		"PROG_SFP_EN", "INT_TPM_N", "NT_RTC_N", "ALERT_TEMP", "", "", "", "",
-		"USB_PWRFAULT", "USB_DRVVBUS", "", "", "", "", "", "", "", "", "", "", "", "", "";
+			  "EXPANSION PIN2", "DP_PWR_FAULT_N", "SFP_TX_FAULT",
+			  "SFP_LOS", "RESET_TPM_N", "PROG_SFP_EN", "INT_TPM_N",
+			  "INT_RTC_N", "ALERT_TEMP", "", "", "", "",
+			  "USB_PWRFAULT", "USB_DRVVBUS", "", "", "", "", "", "", "",
+			  "", "", "", "", "", "";
 
-	RESET_TPM_N {
+	alert-temp-hog {
 		gpio-hog;
-		gpios = <8 0>;
-		output-high;
-		line-name = "RESET_TPM_N";
+		gpios = <12 0>;
+		input;
+		line-name = "ALERT_TEMP";
 	};
 
-	PROG_SFP_EN {
+	default-output-low-hog {
 		gpio-hog;
-		gpios = <9 0>;
+		gpios = <4 0>;
+		line-name = "gpio3_default_output_low";
 		output-low;
-		line-name = "PROG_SFP_EN";
-	};
-
-	INT_TPM_N {
-		gpio-hog;
-		gpios = <10 0>;
-		input;
-		line-name = "INT_TPM_N";
 	};
 
-	INT_RTC_N {
+	int-rtc-n-hog {
 		gpio-hog;
 		gpios = <11 0>;
 		input;
 		line-name = "INT_RTC_N";
 	};
 
-	ALERT_TEMP {
+	int-tpm-n-hog {
 		gpio-hog;
-		gpios = <12 0>;
+		gpios = <10 0>;
 		input;
-		line-name = "ALERT_TEMP";
+		line-name = "INT_TPM_N";
 	};
 
-	gpio3_default_output_low {
+	prog-sfp-en-hog {
 		gpio-hog;
-		gpios = <4 0>;
+		gpios = <9 0>;
+		line-name = "PROG_SFP_EN";
 		output-low;
-		line-name = "gpio3_default_output_low";
 	};
-};
-
-&dspi2 {
-	spi-num-chipselects = <1>;
-	status = "okay";
 
-	slb9670: slb9670@0 {
-		compatible = "infineon,slb9670";
-		reg = <0>; /* CE0 */
-		#address-cells = <1>;
-		#size-cells = <0>;
-		spi-max-frequency = <10000000>;
-		status = "okay";
-		/* Interrupt disabled for now */
-		/*interrupt-parent = <&gpio3>;
-		interrupts = <10 IRQ_TYPE_EDGE_FALLING>;
-		interrupt-names = "INT_TPM_N";*/
+	reset-tpm-n-hog {
+		gpio-hog;
+		gpios = <8 0>;
