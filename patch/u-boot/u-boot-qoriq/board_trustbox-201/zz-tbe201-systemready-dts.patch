-};
-
-&esdhc1 {
-	voltage-ranges = <1800 1800>;
-	mmc-hs200-1_8v;
-	/*mmc-hs400-1_8v;
-	max-frequency = <150000000>;*/
-	bus-width = <8>;
-	non-removable;
-};
-
-&usb0 {
-	status = "okay";
-};
-
-&usb1 {
-	status = "okay";
-};
