diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
index 2a16a7e31c4..553f7b19d9c 100644
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -2175,6 +2175,18 @@ config ARCH_GXP
 	select OF_CONTROL
 	imply CMD_DM
 
+config TARGET_TBE201
+	bool "Support Scalys TrustBox-201"
+	select ARCH_LS1028A
+	select ARM64
+	select ARMV8_MULTIENTRY
+	select ARCH_SUPPORT_TFABOOT
+	select BOARD_LATE_INIT
+	select GPIO_EXTRA_HEADER
+	help
+	  Support for Scalys TrustBox-201 platform
+	  featuring a NXP QorIQ LS1028A Layerscape Architecture processor.
+
 endchoice
 
 config SUPPORT_PASSING_ATAGS
@@ -2440,6 +2452,7 @@ source "board/phytium/durian/Kconfig"
 source "board/phytium/pomelo/Kconfig"
 source "board/phytium/pe2201/Kconfig"
 source "board/xen/xenguest_arm64/Kconfig"
+source "board/scalys/tbe201/Kconfig"
 
 source "arch/arm/Kconfig.debug"
 
diff --git a/arch/arm/dts/tbe201.dts b/arch/arm/dts/tbe201.dts
new file mode 100644
index 00000000000..615368ad68c
--- /dev/null
+++ b/arch/arm/dts/tbe201.dts
@@ -0,0 +1,406 @@
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include "fsl-ls1028a.dtsi"
+
+/ {
+	model = "Scalys Trustbox Edge 201";
+	compatible = "scalys,trustbox-edge-201", "fsl,ls1028a-rdb", "fsl,ls1028a";
+
+	aliases {
+		crypto = &crypto;
+		ethernet0 = &enetc_port0;
+		ethernet1 = &enetc_port2;
+		ethernet2 = &mscc_felix_port0;
+		ethernet3 = &mscc_felix_port1;
+		ethernet4 = &mscc_felix_port2;
+		ethernet5 = &mscc_felix_port3;
+		ethernet6 = &mscc_felix_port4;
+		ethernet7 = &mscc_felix_port5;
+		ethernet8 = &enetc_port3;
+		mmc0 = &esdhc;
+		mmc1 = &esdhc1;
+		rtc1 = &ftm_alarm1;
+		serial0 = &duart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x00000000 0x80000000 0x00000000 0x80000000>,
+		      <0x00000020 0x80000000 0x00000000 0x80000000>;
+	};
+
+	psci {
+		compatible = "arm,psci-1.0", "arm,psci-0.2";
+		method = "smc";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_FAULT;
+			gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led-1 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&gpio3 3 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+
+		led-2 {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_INDICATOR;
+			gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	reg_1p8v: regulator-1p8v {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-max-microvolt = <1800000>;
+		regulator-min-microvolt = <1800000>;
+		regulator-name = "1P8V";
+	};
+
+	sb_3v3: regulator-sb3v3 {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-max-microvolt = <3300000>;
+		regulator-min-microvolt = <3300000>;
+		regulator-name = "3v3_vbus";
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		optee_tzdram: optee@fc000000 {
+			no-map;
+			reg = <0x00000000 0xfc000000 0x00000000 0x03e00000>;
+		};
+
+		optee_shm: shm@ffe00000 {
+			reg = <0x00000000 0xffe00000 0x00000000 0x00200000>;
+		};
+	};
+
+	sfp0: sfp {
+		compatible = "sff,sfp";
+		i2c-bus = <&i2c2>;
+		los-gpios = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+		maximum-power-milliwatt = <2000>;
+		mod-def0-gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
+		tx-disable-gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>;
+		tx-fault-gpios = <&gpio3 6 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&dspi2 {
+	spi-num-chipselects = <1>;
+
+	status = "okay";
+
+	tpm@0 {
+		compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+	};
+};
+
+&duart0 {
+	status = "okay";
+};
+
+&enetc_mdio_pf3 {
+	qsgmii_phy0: ethernet-phy@4 {
+		reg = <0x4>;
+	};
+
+	qsgmii_phy1: ethernet-phy@5 {
+		reg = <0x5>;
+	};
+
+	qsgmii_phy2: ethernet-phy@6 {
+		reg = <0x6>;
+	};
+
+	qsgmii_phy3: ethernet-phy@7 {
+		reg = <0x7>;
+	};
+};
+
+&enetc_port0 {
+	managed = "in-band-status";
+	phy-connection-type = "sgmii";
+	sfp = <&sfp0>;
+
+	status = "okay";
+};
+
+&enetc_port2 {
+	status = "okay";
+};
+
+&enetc_port3 {
+	status = "okay";
+};
+
+&esdhc {
+	cd-gpios = <&gpio1 31 GPIO_ACTIVE_LOW>;
+	disable-wp;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+
+	status = "okay";
+};
+
+&esdhc1 {
+	bus-width = <8>;
+	mmc-hs200-1_8v;
+	non-removable;
+	voltage-ranges = <1800 1800>;
+
+	status = "okay";
+};
+
+&ftm_alarm1 {
+	status = "okay";
+};
+
+&gpio1 {
+	gpio-line-names = "", "", "", "", "", "", "UART_2_SIN", "UART_2_SOUT",
+			  "", "", "UART_1_SIN", "UART_1_SOUT", "", "", "", "", "", "",
+			  "", "", "", "", "USB_2_DRVVBUS", "USB_2_PWRFAULT", "", "",
+			  "", "", "", "", "SDHC_1_WP", "SDHC_1_CD";
+
+	default-output-low-hog {
+		gpio-hog;
+		gpios = <6 0>, <7 0>, <22 0>, <23 0>, <26 0>, <27 0>;
+		line-name = "gpio1_default_output_low";
+		output-low;
+	};
+
+	sdhc-1-wp-hog {
+		gpio-hog;
+		gpios = <30 0>;
+		line-name = "SDHC_1_WP";
+		output-low;
+	};
+};
+
+&gpio2 {
+	gpio-line-names = "", "", "", "", "", "", "ASLEEP", "CLKOUT", "", "", "",
+			  "", "", "", "", "", "", "", "", "", "M2_E_W_DISABLE_1_N",
+			  "EXPANSION PIN4", "EXPANSION PIN6", "M2_B_W_DISABLE_1_N",
+			  "M2_B_POWER_OFF_N", "EXPANSION PIN8", "M2_B_CONFIG_0",
+			  "ALERT_5V_SOM_N", "M2_B_CONFIG_2", "ALERT_12V_N",
+			  "M2_B_CONFIG_3", "M2_B_CONFIG_1";
+
+	default-output-high-hog {
+		gpio-hog;
+		gpios = <20 0>, <23 0>, <24 0>;
+		line-name = "gpio2_default_output_high";
+		output-high;
+	};
+
+	default-output-low-hog {
+		gpio-hog;
+		gpios = <7 0>;
+		line-name = "gpio2_default_output_low";
+		output-low;
+	};
+};
+
+&gpio3 {
+	gpio-line-names = "SFP_TX_DISABLE", "SFP_MOD_ABS", "MDINT_N", "DP_PWR_EN",
+			  "EXPANSION PIN2", "DP_PWR_FAULT_N", "SFP_TX_FAULT",
+			  "SFP_LOS", "RESET_TPM_N", "PROG_SFP_EN", "INT_TPM_N",
+			  "INT_RTC_N", "ALERT_TEMP", "", "", "", "",
+			  "USB_PWRFAULT", "USB_DRVVBUS", "", "", "", "", "", "", "",
+			  "", "", "", "", "", "";
+
+	alert-temp-hog {
+		gpio-hog;
+		gpios = <12 0>;
+		input;
+		line-name = "ALERT_TEMP";
+	};
+
+	default-output-low-hog {
+		gpio-hog;
+		gpios = <4 0>;
+		line-name = "gpio3_default_output_low";
+		output-low;
+	};
+
+	int-rtc-n-hog {
+		gpio-hog;
+		gpios = <11 0>;
+		input;
+		line-name = "INT_RTC_N";
+	};
+
+	int-tpm-n-hog {
+		gpio-hog;
+		gpios = <10 0>;
+		input;
+		line-name = "INT_TPM_N";
+	};
+
+	prog-sfp-en-hog {
+		gpio-hog;
+		gpios = <9 0>;
+		line-name = "PROG_SFP_EN";
+		output-low;
+	};
+
+	reset-tpm-n-hog {
+		gpio-hog;
+		gpios = <8 0>;
+		line-name = "RESET_TPM_N";
+		output-high;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	temperature-sensor@4c {
+		compatible = "ti,tmp451";
+		reg = <0x4c>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
+	};
+
+	rtc@51 {
+		compatible = "nxp,pcf85063tp";
+		reg = <0x51>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
+	};
+};
+
+&i2c2 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+};
+
+&i2c4 {
+	clock-frequency = <100000>;
+
+	status = "okay";
+
+	usb-hub@60 {
+		compatible = "cypress,cyusb3304";
+		reg = <0x60>;
+		configuration = [
+			43 59 30 d4 c0 b4 04 04 65 0a 32 00 03 32 ff 11
+			a0 11 f0 e8 00 08 00 00 12 00 2c 66 66 69 29 29
+			29 29 00 06 65 00 00 00 00 00 00 00 00 04 03 09
+			04 36 03 32 00 30 00 31 00 34 00 20 00 43 00 79
+			00 70 00 72 00 65 00 73 00 73 00 20 00 53 00 65
+			00 6d 00 69 00 63 00 6f 00 6e 00 64 00 75 00 63
+			00 74 00 6f 00 72 00 16 03 43 00 59 00 2d 00 48
+			00 58 00 33 00 20 00 48 00 55 00 42 00 14 03 54
+			00 42 00 45 00 32 00 30 00 31 00
+		];
+	};
+};
+
+&malidp0 {
+	status = "disabled";
+};
+
+&mscc_felix {
+	status = "okay";
+};
+
+&mscc_felix_port0 {
+	label = "swp0";
+	managed = "in-band-status";
+	phy-handle = <&qsgmii_phy0>;
+	phy-mode = "qsgmii";
+
+	status = "okay";
+};
+
+&mscc_felix_port1 {
+	label = "swp1";
+	managed = "in-band-status";
+	phy-handle = <&qsgmii_phy1>;
+	phy-mode = "qsgmii";
+
+	status = "okay";
+};
+
+&mscc_felix_port2 {
+	label = "swp2";
+	managed = "in-band-status";
+	phy-handle = <&qsgmii_phy2>;
+	phy-mode = "qsgmii";
+
+	status = "okay";
+};
+
+&mscc_felix_port3 {
+	label = "swp3";
+	managed = "in-band-status";
+	phy-handle = <&qsgmii_phy3>;
+	phy-mode = "qsgmii";
+
+	status = "okay";
+};
+
+&mscc_felix_port4 {
+	ethernet = <&enetc_port2>;
+
+	status = "okay";
+};
+
+&mscc_felix_port5 {
+	ethernet = <&enetc_port3>;
+
+	status = "okay";
+};
+
+&optee {
+	status = "okay";
+};
+
+&pcie2 {
+	status = "okay";
+};
+
+&sata {
+	status = "okay";
+};
+
+&usb0 {
+	dr_mode = "host";
+
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+&sec_jr2 {
+    status = "disabled";
+};
