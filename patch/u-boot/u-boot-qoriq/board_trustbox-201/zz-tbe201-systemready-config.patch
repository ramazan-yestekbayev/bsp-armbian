From 069758114d3c38cf2bac7610a0e6951ddf60be22 Mon Sep 17 00:00:00 2001
From: ramazan-yestekbayev <ramazan.yestekbayev@sintecs.eu>
Date: Tue, 31 Mar 2026 16:43:09 +0300
Subject: [PATCH] board: tbe201: update configuration for SystemReady

---
 arch/arm/cpu/armv8/Kconfig   |   1 -
 board/scalys/tbe201/tbe201.c |  35 ++++++++++
 configs/tbe201_tfa_defconfig | 126 +++++++++++++++++++++++++++++++++--
 3 files changed, 154 insertions(+), 8 deletions(-)

diff --git a/arch/arm/cpu/armv8/Kconfig b/arch/arm/cpu/armv8/Kconfig
index c66cf2143e6..199335cd604 100644
--- a/arch/arm/cpu/armv8/Kconfig
+++ b/arch/arm/cpu/armv8/Kconfig
@@ -123,7 +123,6 @@ config PSCI_RESET
 		   !TARGET_LS1012A2G5RDB && !TARGET_LS1012AQDS && \
 		   !TARGET_LS1012AFRWY && \
 		   !TARGET_LS1028ARDB && !TARGET_LS1028AQDS && \
-		   !TARGET_TBE201 && \
 		   !TARGET_LS1043ARDB && !TARGET_LS1043AQDS && \
 		   !TARGET_LS1046ARDB && !TARGET_LS1046AQDS && \
 		   !TARGET_LS1046AFRWY && \
diff --git a/board/scalys/tbe201/tbe201.c b/board/scalys/tbe201/tbe201.c
index 5c999e830d4..afad1bcaeaf 100644
--- a/board/scalys/tbe201/tbe201.c
+++ b/board/scalys/tbe201/tbe201.c
@@ -30,6 +30,9 @@
 #include "../drivers/net/fsl_enetc.h"
 #include "hx3_hub.h"
 
+#include <efi_loader.h>
+#include <efi.h>
+
 DECLARE_GLOBAL_DATA_PTR;
 
 #define CYUSB3304_I2C_BUS		"i2c@2040000"
@@ -218,3 +221,35 @@ int checkboard(void)
 	return 0;
 }
 #endif
+
+/* --- SystemReady / EFI Capsule Update Info --- */
+#if defined(CONFIG_EFI_CAPSULE_FIRMWARE_MANAGEMENT)
+
+/*
+ * Test Capsule GUID
+ * 89d98bce-ddc6-44d1-83e7-c8c447ae279b
+ */
+#define TBE201_FIRMWARE_GUID \
+    EFI_GUID(0x89d98bce, 0xddc6, 0x44d1, \
+         0x83, 0xe7, 0xc8, 0xc4, 0x47, 0xae, 0x27, 0x9b)
+
+/* Firmware image description */
+static struct efi_fw_image fw_images[] = {
+    {
+        .image_type_id = TBE201_FIRMWARE_GUID,
+        .fw_name = u"TBE201-FIP",
+        .image_index = 1,
+    },
+};
+
+/*
+ * Capsule update information
+ * We use "firmware" here to match generic tooling.
+ * FIP is at 1 MiB offset (0x800 sectors) on SD (mmc 0).
+ */
+struct efi_capsule_update_info update_info = {
+    .dfu_string = "mmc 0=firmware raw 0x800 0x2000",
+    .num_images = ARRAY_SIZE(fw_images),
+    .images = fw_images,
+};
+#endif
