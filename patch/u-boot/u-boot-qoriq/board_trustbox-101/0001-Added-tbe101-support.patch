+U_BOOT_DRVINFO(ls1012a_pfe0) = {
+	.name = "pfe_eth",
+	.plat = &pfe_pdata0,
+};
+
+U_BOOT_DRVINFO(ls1012a_pfe1) = {
+	.name = "pfe_eth",
+	.plat = &pfe_pdata1,
+};
